"VertexLitGeneric"
{
	"$basetexture" "models/weapons/c_egon/v_egon_screen.vtf"
	"$selfillum" 1
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .9 .9 .9 ]"
	

	"$jumpchance" 0.025
	"$jumpchancethreshold" 0.99
	"$nojump" 0.0
	"$jumpdistance" 0.25
	"$translate1" "[0.0 0.0]"

	"Proxies"
	{
		"GaussianNoise"
		{
			"mean" 0.5
			"halfWidth" 0.2
			"minVal" 0.0
			"maxVal" 1.0
			"resultVar" "$jumpchance"
		}
		"GaussianNoise"
		{
			"mean" 0
			"halfWidth" 0.05
			"minVal" -0.1
			"maxVal" 0.25
			"resultVar" "$jumpdistance"
		}
		"LessOrEqual"
		{
			"srcVar1" "$jumpchance"
			"srcVar2" "$jumpchancethreshold"
			"lessEqualVar" "$nojump"
			"greaterVar" "$jumpdistance"
			"resultVar" "$translate1[1]"
		}
		"TextureTransform"
		{
			"translateVar" "$translate1"
			"resultVar" "$basetexturetransform"
		}

	}
}
