diff --git a/lua/d3bot/sv_targetregistry.lua b/lua/d3bot/sv_targetregistry.lua
new file mode 100644
--- /dev/null
+++ b/lua/d3bot/sv_targetregistry.lua
@@ -0,0 +1,110 @@
+D3bot.TargetRegistry = D3bot.TargetRegistry or {buckets = {}, pending = {}}
+local state = D3bot.TargetRegistry
+
+local function Register(ent)
+	if not IsValid(ent) then return end
+	local class = string.lower(ent:GetClass())
+	for _, bucket in pairs(state.buckets) do
+		if string.match(class, bucket.pattern) and not bucket.members[ent] then
+			bucket.members[ent], bucket.dirty = true, true
+		end
+	end
+end
+
+local function Unregister(ent)
+	state.pending[ent] = nil
+	for _, bucket in pairs(state.buckets) do
+		if bucket.members[ent] then bucket.members[ent], bucket.dirty = nil, true end
+	end
+end
+
+local function Flush(final)
+	for ent in pairs(state.pending) do
+		if IsValid(ent) then
+			state.pending[ent] = nil
+			Register(ent)
+		elseif final then state.pending[ent] = nil end
+	end
+end
+
+local function Bucket(class)
+	if type(class) ~= "string" then return end
+	local bucket = state.buckets[class]
+	if not bucket then
+		local pattern = string.lower(class):gsub("([%^%$%(%)%%%.%[%]%+%-%?])", "%%%1"):gsub("%*", ".*")
+		bucket = {pattern = "^" .. pattern .. "$", members = {}, ordered = {}, dirty = true}
+		state.buckets[class] = bucket
+		for _, ent in ipairs(ents.FindByClass(class)) do if IsValid(ent) then bucket.members[ent] = true end end
+	end
+	return bucket
+end
+
+function D3bot.RegisterBotTargetEntity(ent)
+	Register(ent)
+end
+
+function D3bot.GetBotTargetEntities(classes)
+	Flush()
+	local result = {}
+	for _, class in ipairs(classes or {}) do
+		local bucket = Bucket(class)
+		if bucket then
+			if bucket.dirty then
+				local ordered = {}
+				for ent in pairs(bucket.members) do
+					if IsValid(ent) then ordered[#ordered + 1] = ent else bucket.members[ent] = nil end
+				end
+				table.sort(ordered, function(a, b) return a:EntIndex() < b:EntIndex() end)
+				bucket.ordered, bucket.dirty = ordered, false
+			end
+			for _, ent in ipairs(bucket.ordered) do
+				if IsValid(ent) then result[#result + 1] = ent else Unregister(ent) end
+			end
+		end
+	end
+	return result
+end
+
+function D3bot.IsBotTargetEntity(ent, classes)
+	if not IsValid(ent) then return false end
+	Flush()
+	for _, class in ipairs(classes or {}) do
+		local bucket = Bucket(class)
+		if bucket and bucket.members[ent] then return true end
+	end
+	return false
+end
+
+local defaultBotTargetEntity = D3bot.IsBotTargetEntity
+
+function D3bot.UsesDefaultBotTargetRegistry()
+	return D3bot.IsBotTargetEntity == defaultBotTargetEntity
+end
+
+function D3bot.GetUndeadPlayerTargets()
+ local result,best={},3
+ for _,candidate in (player.Iterator or function()return ipairs(player.GetAll())end)()do
+  if IsValid(candidate)then
+   local team=candidate:Team()
+   local tier=team==TEAM_HUMAN and 1 or TEAM_UNDEAD and team~=TEAM_UNDEAD and 2 or 3
+   if tier<=best and candidate:GetObserverMode()==OBS_MODE_NONE and not candidate:IsFlagSet(FL_NOTARGET)and candidate:Alive()then
+    if tier<best then
+     for index=#result,1,-1 do result[index]=nil end
+     best=tier
+    end
+    result[#result+1]=candidate
+   end
+  end
+ end
+ return result
+end
+
+hook.Add("OnEntityCreated", "D3botTargetRegistry", function(ent)
+	if next(state.buckets) == nil then return end
+	Register(ent)
+	state.pending[ent] = true
+	if state.scheduled then return end
+	state.scheduled = true
+	timer.Simple(0, function() state.scheduled = nil; Flush(true) end)
+end)
+hook.Add("EntityRemoved", "D3botTargetRegistry", Unregister)
