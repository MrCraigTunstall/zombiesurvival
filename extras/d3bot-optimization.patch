+-----------------------------------
+-- Custom functions and settings --
+-----------------------------------
+
+HANDLER.Weapon_Types = {}
+HANDLER.Weapon_Types.RANGED = 1
+HANDLER.Weapon_Types.MELEE = 2
+
+function HANDLER.WeaponRatingFunction(weapon, targetDistance)
+	local sweptable = weapons.GetStored(weapon.ClassName)
+	local weaponType = HANDLER.Weapon_Types.MELEE
+	if weapon.Base == "weapon_zs_base" then
+		weaponType = HANDLER.Weapon_Types.RANGED
+	end
+	
+	local targetDiameter = 6
+	local targetArea = math.pi * math.pow(targetDiameter / 2, 2)
+	
+	local numShots = sweptable.Primary.NumShots or 1
+	local damage = (sweptable.Damage or sweptable.Primary.Damage or 0)
+	local delay = sweptable.Primary.Delay or 1
+	local cone = weapon.GetCone and weapon:GetCone() or ((weapon.ConeMax or 45) + (weapon.ConeMin or 45)*6) / 7
+	
+	local dmgPerSec = damage * numShots / delay -- TODO: Use more parameters like reload time.
+	local maxDistance = targetDiameter / math.tan(math.rad(cone)) / 2
+	local spreadArea = math.pi * math.pow(math.tan(math.rad(cone)) * targetDistance, 2)
+	
+	local areaIntersection = math.min(targetArea, spreadArea) / spreadArea
+	
+	local rating = dmgPerSec * areaIntersection
+	
+	return weaponType, rating, maxDistance
+end
+
+function HANDLER.FindEscapePath(bot, startNode, enemies)
+	if not startNode then return end
+	local tempNodePenalty = {}
+	local falloffContext = #enemies > 1 and {} or nil
+	local escapeDirection = Vector()
+	local origin = bot:GetPos()
+	for _, enemy in pairs(enemies) do
+		local position = enemy:GetPos()
+		D3bot.AddNavigationFalloff(D3bot.GetNavigationNode(position), 2, 1, 0.5, tempNodePenalty, falloffContext)
+		escapeDirection:Add(origin - position)
+	end
+	escapeDirection:Normalize()
+
+	local function pathCostFunction(node, linkedNode, link)
+		local directionPenalty
+		if node == startNode then
+			local direction = D3bot.GetNavigationPosition(linkedNode) - D3bot.GetNavigationPosition(node)
+			direction:Normalize()
+			directionPenalty = (1 - direction:Dot(escapeDirection)) * 1000
+			--ClDebugOverlay.Line(GetPlayerByName("D3"), node.Pos, linkedNode.Pos, nil, Color(directionPenalty/2000*255, 0, 0), true)
+		end
+		local nodeMetadata = D3bot.GetNodePopulationMetadata(linkedNode)
+		local playerFactorBySurvivors = nodeMetadata and nodeMetadata.PlayerFactorByTeam and nodeMetadata.PlayerFactorByTeam[TEAM_SURVIVOR] or 0
+		local playerFactorByUndead = nodeMetadata and nodeMetadata.PlayerFactorByTeam and nodeMetadata.PlayerFactorByTeam[TEAM_UNDEAD] or 0
+		local cost = -playerFactorBySurvivors * 50 + playerFactorByUndead * 150 + (tempNodePenalty[D3bot.GetNavigationKey(linkedNode)] or 0) * 500 + (directionPenalty or 0)
+		--for _, enemy in pairs(enemies) do
+		--	cost = cost + 100 / (LerpVector(0.5, node.Pos, linkedNode.Pos):Distance(enemy:GetPos()) + 100) * 0.1 * node.Pos:Distance(linkedNode.Pos) -- Weight by link length
+		--end
+		return cost-- + node.Pos:Distance(linkedNode.Pos) * 2
+	end
+	local function heuristicCostFunction(node)
+		local nodeMetadata = D3bot.GetNodePopulationMetadata(node)
+		--local playerFactorBySurvivors = nodeMetadata and nodeMetadata.PlayerFactorByTeam and nodeMetadata.PlayerFactorByTeam[TEAM_SURVIVOR] or 0
+		local playerFactorByUndead = nodeMetadata and nodeMetadata.PlayerFactorByTeam and nodeMetadata.PlayerFactorByTeam[TEAM_UNDEAD] or 0
+		return playerFactorByUndead * 150 + (tempNodePenalty[D3bot.GetNavigationKey(node)] or 0) * 10
+	end
+	return (D3bot.UsingSourceNav and D3bot.GetEscapeValveMeshPathOrNil or D3bot.GetEscapeMeshPathOrNil)(startNode, 50, pathCostFunction, heuristicCostFunction, {Walk = true})
+end
+
+function HANDLER.FindPathToHuman(node)
+	if not node then return end
+	local function pathCostFunction(node, linkedNode, link)
+		return D3bot.GetNavigationPosition(node):Distance(D3bot.GetNavigationPosition(linkedNode)) * 0.1
+	end
+	local function heuristicCostFunction(node)
+		local nodeMetadata = D3bot.GetNodePopulationMetadata(node)
+		local playerFactorBySurvivors = nodeMetadata and nodeMetadata.PlayerFactorByTeam and nodeMetadata.PlayerFactorByTeam[TEAM_SURVIVOR] or 0
+		local playerFactorByUndead = nodeMetadata and nodeMetadata.PlayerFactorByTeam and nodeMetadata.PlayerFactorByTeam[TEAM_UNDEAD] or 0
+		return -playerFactorBySurvivors * 1600000 + playerFactorByUndead * 500000
+	end
+	--D3bot.Debug.DrawNodeMetadata(GetPlayerByName("D3"), D3bot.NodeMetadata, 5)
+	--D3bot.Debug.DrawPath(GetPlayerByName("D3"), D3bot.GetEscapeMeshPathOrNil(node, 400, pathCostFunction, heuristicCostFunction, {Walk = true}), 5, Color(255, 0, 0), true)
+	return (D3bot.UsingSourceNav and D3bot.GetEscapeValveMeshPathOrNil or D3bot.GetEscapeMeshPathOrNil)(node, 400, pathCostFunction, heuristicCostFunction, {Walk = true})
+end
+
+function HANDLER.CanShootTarget(bot, target)
+	if not IsValid(target) then return end
+	local origin = bot:EyePos()
+	local targetPos = target:EyePos()
+	local mem = bot.D3bot_Mem
+	local trace = mem and mem.CanShootTrace
+	if mem and not trace then trace = {};mem.CanShootTrace = trace end
+	return D3bot.CanShootWithoutPlayers(origin, targetPos, MASK_SHOT_HULL, trace)
+end
+
+local playerMeta = FindMetaTable and FindMetaTable("Player")
+local entityMeta = FindMetaTable and FindMetaTable("Entity")
+local nativeEyePos = playerMeta and playerMeta.EyePos or entityMeta and entityMeta.EyePos
+local nativeAimVector = playerMeta and playerMeta.GetAimVector or entityMeta and entityMeta.GetAimVector
+local nativeGeometry = type(nativeEyePos) == "function" and type(nativeAimVector) == "function"
+ and debug.getinfo(nativeEyePos, "S").what == "C" and debug.getinfo(nativeAimVector, "S").what == "C"
+local checkedEyeTrace, checkedPlayerTrace, boundedEyeTrace
+
+CanBoundBarricadeTrace = function(bot)
+ local eyeTrace, playerTrace = bot.GetEyeTrace, util.GetPlayerTrace
+ if eyeTrace ~= checkedEyeTrace or playerTrace ~= checkedPlayerTrace then
+  checkedEyeTrace, checkedPlayerTrace = eyeTrace, playerTrace
+  boundedEyeTrace = type(eyeTrace) == "function" and type(playerTrace) == "function"
+   and debug.getinfo(eyeTrace, "S").source == "@gamemodes/base/gamemode/obj_player_extend.lua"
+   and debug.getinfo(playerTrace, "S").source == "@lua/includes/extensions/util.lua"
+ end
+ return nativeGeometry and boundedEyeTrace and bot.EyePos == nativeEyePos and bot.GetAimVector == nativeAimVector
+end
+
+local function FullBarricadeTrace(bot)
+ local tr = bot:GetEyeTrace()
+ local entity = tr.Entity
+ local distanceSqr = bot:EyePos():DistToSqr(tr.HitPos)
+ if not IsValid(entity) or not entity:IsNailed() then return end
+ return distanceSqr < 100 * 100
+end
+
+function HANDLER.FacesBarricade(bot)
+ if not CanBoundBarricadeTrace(bot) then return FullBarricadeTrace(bot) end
+ local origin = bot:EyePos()
+ local endpoint = bot:GetAimVector()
+ endpoint:Mul(101)
+ endpoint:Add(origin)
+ local tr = util.TraceLine({start = origin, endpos = endpoint, filter = bot})
+ local distanceSqr = bot:EyePos():DistToSqr(tr.HitPos)
+ if distanceSqr >= 9996 and distanceSqr <= 10004 then return FullBarricadeTrace(bot) end
+ return IsValid(tr.Entity) and tr.Entity:IsNailed() and distanceSqr < 100 * 100
+end
+
+phaseTrace = HANDLER.FacesBarricade
+
+function HANDLER.IsEnemy(bot, ply)
+	local ownTeam = bot:Team()
+	if IsValid(ply) and bot ~= ply and ply:IsPlayer() and ply:Team() ~= ownTeam and ply:GetObserverMode() == OBS_MODE_NONE and ply:Alive() then return true end
+end
+
+function HANDLER.IsFriend(bot, ply)
+	local ownTeam = bot:Team()
+	if IsValid(ply) and bot ~= ply and ply:IsPlayer() and ply:Team() == ownTeam and ply:GetObserverMode() == OBS_MODE_NONE and ply:Alive() then return true end
+end
+
+function HANDLER.CanBeAttackTgt(bot, target)
+	if not target or not IsValid(target) then return end
+	local ownTeam = bot:Team()
+	if target:IsPlayer() and target ~= bot and target:Team() ~= ownTeam and target:GetObserverMode() == OBS_MODE_NONE and target:Alive() then return true end
+end
