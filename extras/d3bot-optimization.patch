diff --git a/lua/d3bot/sv_navigation.lua b/lua/d3bot/sv_navigation.lua
new file mode 100644
--- /dev/null
+++ b/lua/d3bot/sv_navigation.lua
@@ -0,0 +1,110 @@
+function D3bot.GetNavigationKey(node)
+	if D3bot.UsingSourceNav then return node:GetID() end
+	return node
+end
+
+function D3bot.GetNavigationNode(position)
+	if not position then return nil end
+	if D3bot.UsingSourceNav then
+		local node=navmesh.GetNearestNavArea(position)
+		if IsValid(node)then return node end
+	else
+		local mesh=D3bot.MapNavMesh
+		if mesh then return mesh:GetNearestNodeOrNil(position)end
+	end
+end
+
+function D3bot.GetNavigationPosition(node)
+	if D3bot.UsingSourceNav then return node:GetCenter()end
+	return node.Pos
+end
+
+function D3bot.GetNodePopulationMetadata(node,create)
+	if not node then return end
+	local key=D3bot.GetNavigationKey(node)
+	local metadata=D3bot.NodeMetadata[key]
+	if not metadata and create then metadata={};D3bot.NodeMetadata[key]=metadata end
+	return metadata
+end
+
+function D3bot.AddNavigationFalloff(node,depth,value,falloff,values,context)
+	values=values or{}
+	if not node then return values end
+	local queue,levels,weights={node},{0},{value}
+	local root=D3bot.GetNavigationKey(node)
+ local entries
+ if context and getmetatable(values)==nil then
+  if context.depth~=depth or context.value~=value or context.falloff~=falloff or context.source~=D3bot.UsingSourceNav or context.key~=D3bot.GetNavigationKey then
+   context.entries={}context.depth,context.value,context.falloff=depth,value,falloff
+   context.source,context.key=D3bot.UsingSourceNav,D3bot.GetNavigationKey
+  end
+  entries=context.entries
+  local cached=entries and entries[root]
+  if cached then
+   for key,weight in pairs(cached)do values[key]=(values[key]or 0)+weight end
+   return values
+  end
+ end
+ local visited={[root]=value}
+	local head,count=1,1
+	while head<=count do
+		local current,level,weight=queue[head],levels[head],weights[head]
+		local key=D3bot.GetNavigationKey(current)
+		values[key]=(values[key]or 0)+weight
+		if level<depth and count<64 then
+			local adjacent=D3bot.UsingSourceNav and current:GetAdjacentAreas()or current.LinkByLinkedNode
+			for index,item in pairs(adjacent)do
+				if count>=64 then break end
+				local nextNode=D3bot.UsingSourceNav and item or index
+				local nextKey=D3bot.GetNavigationKey(nextNode)
+				if not visited[nextKey]and count<64 then
+					visited[nextKey]=weight*falloff;count=count+1
+					queue[count],levels[count],weights[count]=nextNode,level+1,weight*falloff
+				end
+			end
+		end
+		head=head+1
+	end
+ if entries then entries[root]=visited end
+ return values
+end
+
+function D3bot.GetNearbyEnemies(bot,position,isEnemy)
+	local enemies,close,closer,dangerous={},{},{},{}
+	for _,actor in(player.Iterator or function()return ipairs(player.GetAll())end)()do
+		if isEnemy(bot,actor)then
+			enemies[#enemies+1]=actor
+			local distance=position:DistToSqr(actor:GetPos())
+			if distance<1000000 then
+				close[#close+1]=actor
+				if distance<360000 then
+					closer[#closer+1]=actor
+					if distance<90000 then dangerous[#dangerous+1]=actor end
+				end
+			end
+		end
+	end
+	return enemies,close,closer,dangerous
+end
+
+local function IgnorePlayers(entity)return not entity:IsPlayer()end
+
+function D3bot.TraceLineWithoutPlayers(origin,target,mask,trace)
+	trace=trace or{}
+	trace.start,trace.endpos,trace.mask,trace.filter=origin,target,mask,IgnorePlayers
+	return util.TraceLine(trace)
+end
+
+function D3bot.CanShootWithoutPlayers(origin,target,mask,cache)
+	if not cache or cache.InUse then return not D3bot.TraceLineWithoutPlayers(origin,target,mask).Hit end
+	local input = cache.Input
+	if not input then input = {};cache.Input = input end
+	local output = cache.Output
+	if not output then output = {};cache.Output = output end
+	for key in pairs(input) do input[key] = nil end
+	input.output = output
+	cache.InUse = true
+	local hit = D3bot.TraceLineWithoutPlayers(origin,target,mask,input).Hit
+	cache.InUse = nil
+	return not hit
+end
