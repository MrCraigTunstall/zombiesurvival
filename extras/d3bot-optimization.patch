+local function QueueBefore(queue, left, right)
+	local leftCost, rightCost = queue.costs[left], queue.costs[right]
+	if leftCost ~= rightCost then return leftCost < rightCost end
+	return queue.order[left] > queue.order[right]
+end
+
+local function QueueSwap(queue, left, right)
+	local items = queue.items
+	items[left], items[right] = items[right], items[left]
+	queue.positions[items[left]], queue.positions[items[right]] = left, right
+end
+
+local function QueueUp(queue, index)
+	while index > 1 do
+		local parent = math.floor(index / 2)
+		if not QueueBefore(queue, queue.items[index], queue.items[parent]) then break end
+		QueueSwap(queue, index, parent)
+		index = parent
+	end
+	return index
+end
+
+local function QueueDown(queue, index)
+	local items = queue.items
+	while index * 2 <= #items do
+		local child = index * 2
+		if child < #items and QueueBefore(queue, items[child + 1], items[child]) then child = child + 1 end
+		if not QueueBefore(queue, items[child], items[index]) then break end
+		QueueSwap(queue, index, child)
+		index = child
+	end
+end
+
+function PathQueue:Enqueue(node)
+	local index = self.positions[node]
+	if not index then
+		self.sequence = self.sequence + 1
+		self.order[node] = self.sequence
+		index = #self.items + 1
+		self.items[index], self.positions[node] = node, index
+	end
+	QueueDown(self, QueueUp(self, index))
+end
+
+function PathQueue:Dequeue()
+	local items = self.items
+	local node = items[1]
+	if not node then return end
+	local last = items[#items]
+	items[#items] = nil
+	self.positions[node], self.order[node] = nil, nil
+	if #items > 0 then
+		items[1], self.positions[last] = last, 1
+		QueueDown(self, 1)
+	end
+	return node
+end
+
+local function NewPathQueue(costs)
+	return setmetatable({items = {}, positions = {}, order = {}, costs = costs, sequence = 0}, PathQueue)
+end
 
