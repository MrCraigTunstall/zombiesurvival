+function D3bot.FindNearbyPlayerTarget(bot, position, canTarget)
+	local nearest, distances, count = {}, {}, 0
+	local iterator = player.Iterator or function() return ipairs(player.GetAll()) end
+	for _, candidate in iterator() do
+		if IsValid(candidate) then
+			local distance = position:DistToSqr(candidate:GetPos())
+			if distance < 250000 and (count < 4 or distance < distances[4]) then
+				local index = math.min(count + 1, 4)
+				while index > 1 and distance < distances[index - 1] do
+					nearest[index], distances[index] = nearest[index - 1], distances[index - 1]
+					index = index - 1
+				end
+				nearest[index], distances[index] = candidate, distance
+				count = math.min(count + 1, 4)
+			end
+		end
+	end
+	for index = 1, count do
+		local candidate = nearest[index]
+		if canTarget(bot, candidate) and bot:D3bot_CanSeeTarget(nil, candidate) then return candidate end
+	end
+end
+
+local defaultNearbyPlayerTarget = D3bot.FindNearbyPlayerTarget
+
+local function EligibleUndeadPlayer(bot, candidate)
+	return IsValid(candidate) and candidate ~= bot and candidate:IsPlayer() and candidate:Team() ~= TEAM_UNDEAD
+		and candidate:GetObserverMode() == OBS_MODE_NONE and not candidate:IsFlagSet(FL_NOTARGET) and candidate:Alive()
+end
+
+function D3bot.FindNearbyUndeadPlayerTarget(bot, position, canTarget)
+	if D3bot.FindNearbyPlayerTarget ~= defaultNearbyPlayerTarget or type(D3bot.UsesDefaultBotTargetRegistry) ~= "function"
+		or not D3bot.UsesDefaultBotTargetRegistry() then return D3bot.FindNearbyPlayerTarget(bot, position, canTarget) end
+	local nearest, distances, count = {}, {}, 0
+	local iterator = player.Iterator or function() return ipairs(player.GetAll()) end
+	for _, candidate in iterator() do
+		if EligibleUndeadPlayer(bot, candidate) then
+			local distance = position:DistToSqr(candidate:GetPos())
+			if distance < 250000 and (count < 4 or distance < distances[4]) then
+				local index = math.min(count + 1, 4)
+				while index > 1 and distance < distances[index - 1] do
+					nearest[index], distances[index] = nearest[index - 1], distances[index - 1]
+					index = index - 1
+				end
+				nearest[index], distances[index] = candidate, distance
+				count = math.min(count + 1, 4)
+			end
+		end
+	end
+	for index = 1, count do
+		local candidate = nearest[index]
+		if canTarget(bot, candidate) and bot:D3bot_CanSeeTarget(nil, candidate) and EligibleUndeadPlayer(bot, candidate) then return candidate end
+	end
+end
