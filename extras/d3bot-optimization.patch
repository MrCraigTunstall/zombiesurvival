+local HANDLER = {}
+D3bot.Handlers.Undead_Zombine = HANDLER
+setmetatable(HANDLER, {__index = function(_, key) return D3bot.Handlers.Undead_Fallback[key] end})
+HANDLER.Fallback = false
+
+function HANDLER.SelectorFunction(name, team)
+ return team == TEAM_UNDEAD and name == "Zombine"
+end
+
+function HANDLER.UpdateBotCmdFunction(bot, cmd)
+ D3bot.Handlers.Undead_Fallback.UpdateBotCmdFunction(bot, cmd)
+ if not bot:Alive() or bot.KnockedDown and IsValid(bot.KnockedDown)
+  or bot.Revive and type(bot.Revive) ~= "function" and IsValid(bot.Revive) then return end
+ local mem, weapon = bot.D3bot_Mem, bot:GetActiveWeapon()
+ if not mem or not IsValid(weapon) or weapon:GetClass() ~= "weapon_zs_zombine" then return end
+ local now, target = CurTime(), mem.TgtOrNil
+ local allowed = IsValid(target) and target:IsPlayer() and target:Alive() and target:Team() == TEAM_HUMAN
+  and not mem.DontAttackTgt and not mem.PosTgtOrNil and not mem.IsOnLadder
+  and not (mem.BlockMovementUntil and mem.BlockMovementUntil >= now)
+  and bot:OnGround() and bot:WaterLevel() < 2 and bot:GetMoveType() == MOVETYPE_WALK
+ if target ~= mem.ZSZombineTarget or not mem.ZSZombineChecked or now < mem.ZSZombineChecked or now >= mem.ZSZombineChecked + 0.2 then
+  mem.ZSZombineTarget, mem.ZSZombineChecked = target, now
+  mem.ZSZombineGrenade, mem.ZSZombineSprint = false, false
+  if allowed then
+   local distance = bot:GetPos():DistToSqr(target:GetPos())
+   local armed = weapon:GetGrenading()
+   mem.ZSZombineSprint = distance > (armed and 32 * 32 or 96 * 96) and distance <= 2048 * 2048
+   mem.ZSZombineGrenade = not armed and distance <= 192 * 192
+    and weapon:Clip2() >= weapon.RequiredClip and now >= weapon:GetSpawnedTime()
+    and bot:D3bot_CanSeeTargetCached()
+  end
+ end
+ if allowed and mem.ZSZombineGrenade and not weapon:GetGrenading()
+  and weapon:Clip2() >= weapon.RequiredClip and now >= weapon:GetSpawnedTime() then
+  cmd:RemoveKey(IN_ATTACK)
+  if not weapon:IsInAttackAnim() and now >= weapon:GetNextSecondaryFire() then
+   cmd:SetButtons(bit.bor(cmd:GetButtons(), IN_ATTACK2))
+  end
+  return
+ end
+ local sprint = allowed and mem.ZSZombineSprint or false
+ if sprint ~= weapon:IsMoaning() and now >= (weapon.NextMoanToggle or 0) and not weapon:IsInAttackAnim()
+  and not (weapon:GetGrenading() and now < weapon:GetGrenadeTime()) then
+  cmd:SetButtons(bit.bor(cmd:GetButtons(), IN_RELOAD))
+ end
+end
